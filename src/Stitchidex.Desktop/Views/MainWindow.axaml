<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Stitchidex.Desktop.Views.MainWindow" Title="Stitchidex 0.5.0 (.NET) — Craft Studio" Width="1480" Height="900" KeyDown="OnWindowKeyDown"
        Foreground="{DynamicResource StudioText}">
  <DockPanel>
    <!-- Top Studio Bar -->
    <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource StudioPanel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StudioBorder}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Width="460" Watermark="Search patterns by title, subject, thread color, #PES version, or tag..." Text="{Binding SearchText}"/>
          <ToggleButton IsChecked="{Binding SmartSearchEnabled}" Content="{Binding SmartSearchPill}" CornerRadius="14"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center" IsVisible="{Binding IsScanning}">
          <ProgressBar Width="220" Minimum="0" Maximum="100" Value="{Binding ScanProgress}" Foreground="{DynamicResource StudioAccent}"/>
          <TextBlock Text="{Binding ScanStatusText}" Classes="muted" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
          <Button Content="✕ Cancel" Command="{Binding CancelScanCommand}" Padding="8,3" FontSize="11"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="▦ Thumbnail Grid" Command="{Binding ShowGridCommand}"/>
          <Button Content="☰ Table View" Command="{Binding ShowTableCommand}"/>
          <TextBlock Text="Theme" VerticalAlignment="Center"/>
          <ComboBox Width="190" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource StudioPanel}"><TextBlock Text="{Binding StatusMessage}" Classes="muted"/></Border>
    <Grid ColumnDefinitions="276,*,380">
      <!-- Left Sidebar -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Margin="10" Spacing="10">
          <Border Classes="card"><StackPanel Spacing="6">
            <TextBlock Classes="h" Text="Watched Pattern Folders (Read-Only)"/>
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" MaxHeight="200" Background="Transparent"/>
            <Grid ColumnDefinitions="*,*">
              <Button Content="➕ Add Folder" Click="OnAddFolder" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsScanning}"/>
              <Button Grid.Column="1" Margin="6,0,0,0" Content="➖ Remove Folder" Command="{Binding RemoveFolderCommand}" HorizontalAlignment="Stretch"/>
            </Grid>
            <Button Content="🔄 Scan / Refresh All" Command="{Binding RescanAllCommand}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsScanning}"/>
            <Button Content="Show all folders" Command="{Binding ClearFolderFilterCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="6">
            <TextBlock Classes="h" Text="Faceted Filters"/>
            <TextBlock Text="Brother Hoop" Classes="muted"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding HoopCategories}" SelectedItem="{Binding SelectedHoop}"/>
            <TextBlock Text="Format" Classes="muted"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FormatFamilies}" SelectedItem="{Binding SelectedFormat}"/>
            <TextBlock Text="Craft Tag" Classes="muted"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CraftTags}" SelectedItem="{Binding SelectedCraftTag}"/>
            <TextBlock Text="Max Stitches" Classes="muted"/>
            <TextBox Text="{Binding MaxStitchesText}" Watermark="e.g. 20000"/>
            <TextBlock Text="Max Colors" Classes="muted"/>
            <TextBox Text="{Binding MaxColorsText}" Watermark="e.g. 6"/>
            <Button Content="Reset Filters" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Stretch"/>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <!-- Center Catalog Pane -->
      <DockPanel Grid.Column="1" Margin="4,10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,6,8">
          <TextBlock Text="{Binding PatternsFoundText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding TagSelectedLabel}" Click="OnBulkTag"/>
            <Button Classes="primary" Content="💾 Send to USB" Click="OnSendToUsb"/>
          </StackPanel>
        </Grid>
        <Panel>
          <!-- Multiple (not Toggle): click selects only that card; Ctrl+Click toggles; Shift+Click selects a range -->
          <ListBox x:Name="GridList" IsVisible="{Binding IsGridView}" ItemsSource="{Binding Patterns}" SelectionMode="Multiple"
                   SelectedItem="{Binding SelectedPattern}" SelectionChanged="OnGridSelectionChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="studiocard" Width="218" Height="296" CornerRadius="12" Padding="10">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#2D3748" CornerRadius="8" Height="160">
                      <Image Source="{Binding Thumbnail}" Width="148" Height="148" Stretch="Uniform"/>
                    </Border>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding ThreadDots}" Margin="0,6,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding}" BorderBrush="#66FFFFFF" BorderThickness="0.5"/>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                      <Border Classes="pill emerald" IsVisible="{Binding IsSmallHoop}"><TextBlock Text="{Binding HoopPill}" FontSize="10" FontWeight="SemiBold"/></Border>
                      <Border Classes="pill amber" IsVisible="{Binding IsLargeHoop}"><TextBlock Text="{Binding HoopPill}" FontSize="10" FontWeight="SemiBold"/></Border>
                      <Border Classes="pill"><TextBlock Text="{Binding FormatBadge, StringFormat='.{0}'}" FontSize="10"/></Border>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Spacing="2">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="{Binding CardSubtitle}" Classes="muted"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DataGrid x:Name="TableGrid" IsVisible="{Binding !IsGridView}" ItemsSource="{Binding Patterns}" SelectionMode="Extended"
                    SelectedItem="{Binding SelectedPattern}" SelectionChanged="OnTableSelectionChanged" IsReadOnly="True" CanUserSortColumns="True" RowHeight="54">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="60">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Border Background="#2D3748" CornerRadius="4" Width="48" Height="48"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Title / Subject" Binding="{Binding Title}" Width="2*"/>
              <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="1.5*"/>
              <DataGridTextColumn Header="Format" Binding="{Binding FormatBadge}" Width="70"/>
              <DataGridTextColumn Header="Dimensions (mm / in)" Binding="{Binding SizeBothText}" Width="1.6*"/>
              <DataGridTextColumn Header="Stitches" Binding="{Binding StitchCount}" Width="90"/>
              <DataGridTextColumn Header="Colors" Binding="{Binding ColorCount}" Width="70"/>
              <DataGridTextColumn Header="Smallest Brother Hoop" Binding="{Binding HoopCategory}" Width="1.4*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Panel>
      </DockPanel>
      <!-- Right Inspector -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Margin="10" Spacing="10" IsVisible="{Binding HasSelection}">
          <Border Classes="card"><StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h" Text="Stitch Preview" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding PreviewBackgroundOptions}" SelectedItem="{Binding SelectedPreviewBackground}" ToolTip.Tip="Preview Canvas"/>
            </Grid>
            <Border Background="{Binding PreviewBackgroundHex}" CornerRadius="8" Height="272">
              <Image Source="{Binding SelectedPattern.Thumbnail}" Width="256" Height="256" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="{Binding SelectedPattern.Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedPattern.FileName}" Classes="muted" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="6">
            <TextBlock Classes="h" Text="Pattern Metadata &amp; Geometry Inspector"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="badge"><TextBlock Text="{Binding SelectedPattern.HoopFitBadge}" TextWrapping="Wrap" FontSize="11"/></Border>
              <Border Grid.Row="0" Grid.Column="1" Classes="badge"><TextBlock Text="{Binding SelectedPattern.StitchBadge, StringFormat='Stitch count: {0}'}" TextWrapping="Wrap" FontSize="11"/></Border>
              <Border Grid.Row="1" Grid.Column="0" Classes="badge"><TextBlock Text="{Binding SelectedPattern.SizeBothText}" TextWrapping="Wrap" FontSize="11"/></Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="badge"><TextBlock Text="{Binding SelectedPattern.ColorsFormatBadge}" TextWrapping="Wrap" FontSize="11"/></Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="badge"><TextBlock Text="{Binding SelectedPattern.JumpsTrimsBadge}" TextWrapping="Wrap" FontSize="11"/></Border>
              <Border Grid.Row="2" Grid.Column="1" Classes="badge"><TextBlock Text="{Binding SmartStatus, StringFormat='Smart Search: {0}'}" TextWrapping="Wrap" FontSize="11"/></Border>
            </Grid>
          </StackPanel></Border>
          <Button Classes="primary" Content="💾 Send to USB Drive" Click="OnSendToUsb" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
          <Border Classes="card"><StackPanel Spacing="6">
            <TextBlock Classes="h" Text="User Notes &amp; Custom Tags"/>
            <ItemsControl ItemsSource="{Binding SelectedPattern.Tags}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    <Button Content="✕" Padding="2,0" FontSize="10"
                            Command="{Binding $parent[Window].DataContext.RemoveTagCommand}" CommandParameter="{Binding}"/>
                  </StackPanel></Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="QuickTagBox" Text="{Binding NewTagText}" Watermark="Quick tag (F2)…"/>
              <Button Grid.Column="1" Margin="4,0,0,0" Content="Add" Command="{Binding AddTagCommand}"/>
            </Grid>
            <TextBox Text="{Binding NotesText}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Watermark="Notes…"/>
            <Button Content="Save Notes" Command="{Binding SaveNotesCommand}"/>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="4">
            <TextBlock Classes="h" Text="Thread Palette Swatches"/>
            <ItemsControl ItemsSource="{Binding SelectedPattern.Palette}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2" ToolTip.Tip="{Binding Brand}">
                    <Border Width="28" Height="18" CornerRadius="4" Background="{Binding Hex}" BorderBrush="#66888888" BorderThickness="1"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Hex}" Classes="muted" VerticalAlignment="Center" FontFamily="monospace"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
