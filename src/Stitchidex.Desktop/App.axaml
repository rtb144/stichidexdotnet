<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Stitchidex.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Craft Studio Dark -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StudioWindow" Color="#0F172A"/>
          <SolidColorBrush x:Key="StudioPanel" Color="#1E293B"/>
          <SolidColorBrush x:Key="StudioCard" Color="#26334D"/>
          <SolidColorBrush x:Key="StudioCardHover" Color="#2E3F5E"/>
          <SolidColorBrush x:Key="StudioCardSelected" Color="#1E2B4D"/>
          <SolidColorBrush x:Key="StudioAccent" Color="#6366F1"/>
          <SolidColorBrush x:Key="StudioBorder" Color="#334155"/>
          <SolidColorBrush x:Key="StudioText" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="StudioMuted" Color="#94A3B8"/>
          <SolidColorBrush x:Key="StudioPill" Color="#334155"/>
        </ResourceDictionary>
        <!-- Warm Atelier Light -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StudioWindow" Color="#F8FAFC"/>
          <SolidColorBrush x:Key="StudioPanel" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="StudioCard" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="StudioCardHover" Color="#F5F3FF"/>
          <SolidColorBrush x:Key="StudioCardSelected" Color="#EEF2FF"/>
          <SolidColorBrush x:Key="StudioAccent" Color="#4F46E5"/>
          <SolidColorBrush x:Key="StudioBorder" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="StudioText" Color="#0F172A"/>
          <SolidColorBrush x:Key="StudioMuted" Color="#64748B"/>
          <SolidColorBrush x:Key="StudioPill" Color="#E2E8F0"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource StudioWindow}"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource StudioPanel}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="TextBlock.h"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource StudioMuted}"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Border.badge"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="{DynamicResource StudioPill}"/></Style>
    <Style Selector="Border.pill"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="7,1"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Background" Value="{DynamicResource StudioPill}"/></Style>
    <Style Selector="Border.pill.emerald"><Setter Property="Background" Value="#10B981"/></Style>
    <Style Selector="Border.pill.amber"><Setter Property="Background" Value="#F59E0B"/></Style>
    <Style Selector="Border.pill.emerald TextBlock, Border.pill.amber TextBlock"><Setter Property="Foreground" Value="#0F172A"/></Style>
    <Style Selector="Border.chip"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#446366F1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource StudioAccent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <!-- Studio pattern cards -->
    <Style Selector="ListBox#GridList"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox#GridList ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="ListBox#GridList ListBoxItem Border.studiocard"><Setter Property="Background" Value="{DynamicResource StudioCard}"/><Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="ListBox#GridList ListBoxItem:pointerover Border.studiocard"><Setter Property="Background" Value="{DynamicResource StudioCardHover}"/></Style>
    <Style Selector="ListBox#GridList ListBoxItem:selected Border.studiocard"><Setter Property="Background" Value="{DynamicResource StudioCardSelected}"/><Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="ListBox#GridList ListBoxItem:selected /template/ ContentPresenter, ListBox#GridList ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
  </Application.Styles>
</Application>
